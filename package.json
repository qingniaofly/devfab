{
  "name": "devfab",
  "version": "1.0.0",
  "description": "Devfab is a library for developer building low code factory",
  "main": "./dist/index.js",
  "module": "./dist/index.esm.js",
  "umd": "./dist/index.umd.js",
  "scripts": {
    "clean": "rimraf dist lib",
    "dev": "npm run clean && cross-env NODE_ENV=development rollup -c",
    "build": "npm run clean && cross-env NODE_ENV=production rollup -c",
    "smoke": "node scripts/smoke.js",
    "lint": "eslint \"src/**/*.{js,jsx}\"",
    "lint:fix": "eslint \"src/**/*.{js,jsx}\" --fix",
    "format": "prettier --write \"src/**/*.{js,jsx}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx}\"",
    "publish:public": "npm publish --access public"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:qingniaofly/devfab.git"
  },
  "bugs": {
    "url": "https://github.com/qingniaofly/devfab/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "devfab",
    "developer factory",
    "developer library",
    "low code facory",
    "builder",
    "model render",
    "react",
    "vue",
    "javascipt"
  ],
  "files": [
    "LICENSE",
    "README.md",
    "dist",
    "lib"
  ],
  "author": "qingniaofly",
  "license": "ISC",
  "peerDependencies": {
    "classnames": ">=1.0.0",
    "react": ">=16.0.0",
    "react-dom": ">=16.0.0",
    "vue": ">=3.0"
  },
  "devDependencies": {
    "@babel/core": "^7.15.5",
    "@babel/preset-env": "^7.15.4",
    "@babel/preset-react": "^7.18.6",
    "@rollup/plugin-babel": "^5.3.1",
    "@rollup/plugin-commonjs": "^20.0.0",
    "@rollup/plugin-node-resolve": "^13.1.3",
    "@rollup/plugin-terser": "^0.4.4",
    "@vue/babel-plugin-jsx": "^1.2.2",
    "@vue/compiler-sfc": "^3.2.8",
    "cross-env": "^7.0.3",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.34.1",
    "eslint-plugin-react-hooks": "^4.6.0",
    "prettier": "^3.2.5",
    "rimraf": "^3.0.2",
    "rollup": "^2.56.3",
    "rollup-plugin-copy": "2.0.1",
    "rollup-plugin-postcss": "2.8.2",
    "rollup-plugin-replace": "^2.2.0",
    "vue": "^3.4.0"
  }
}
